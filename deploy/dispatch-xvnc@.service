# Display :%i's X server and VNC server in one process (TigerVNC's Xvnc), part of dispatch-display@%i.target.
# displays.ts writes /run/dispatch/display-%i.env (its VNC port, size and time zone) before it starts
# the target, then waits for the X socket and for the VNC server to take the relay. Only the relay
# connects, over loopback, and it does its own sign-in check; every connection comes from 127.0.0.1,
# so a blacklist of hosts that fail to sign in could only lock the relay out.
[Unit]
Description=Dispatch display :%i (Xvnc)
PartOf=dispatch-display@%i.target

[Service]
Slice=dispatch-displays.slice
Environment=HOME=/root USER=root LANG=C.UTF-8
EnvironmentFile=/run/dispatch/display-%i.env
# A lock or socket left by an X server that is gone (a crash, a reboot) would stop this one taking the
# display. displays.ts refuses to start the display while an X server it didn't start holds it.
ExecStartPre=/bin/rm -f /tmp/.X%i-lock /tmp/.X11-unix/X%i
# Two servers starting at once race to create the socket folder, and the loser runs without a socket.
ExecStartPre=/usr/bin/install -d -m 1777 /tmp/.X11-unix
ExecStart=Xvnc :%i -geometry ${GEOMETRY} -depth 24 -dpi 96 -rfbport ${VNC_PORT} -localhost -SecurityTypes None -UseBlacklist=0 -AlwaysShared -AcceptSetDesktopSize=0 -nolisten tcp -s 0 -dpms -desktop "dispatch :%i"
Restart=on-failure
RestartSec=1
