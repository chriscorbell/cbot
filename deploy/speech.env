# The speech service's fixed address on a host, on its internal Docker network: scripts/release.sh
# passes this file to deploy/speech.compose.yaml, and deploy/dispatch.service reads it so the server
# reaches the service at http://$SPEECH_IP:8000 (server/src/env.ts). The development compose.yaml
# names the service instead. The address must be inside the subnet.
SPEECH_SUBNET=172.31.250.0/29
SPEECH_IP=172.31.250.2
