# Dispatch on its production host. scripts/provision.sh installs this as /etc/systemd/system/dispatch.service.
[Unit]
Description=Dispatch
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/srv/dispatch/current
# HOST is loopback only: Tailscale Serve holds 8787 on the tailnet address and passes HTTPS on to it.
Environment=NODE_ENV=production HOST=127.0.0.1 PORT=8787 DATA_DIR=/var/lib/dispatch LANG=C.UTF-8
# SPEECH_IP: the speech service's fixed address on its Docker network, from the running release.
EnvironmentFile=/srv/dispatch/current/deploy/speech.env
# TZ and the rest, from .env.prod on the dev machine (scripts/deploy.sh). The account is in the database.
EnvironmentFile=/etc/dispatch/env
# Each release brings its own Node (scripts/build-release.sh), so the machine's Node, which the bots
# use, can change without touching Dispatch.
ExecStart=/srv/dispatch/current/node/bin/node server/dist/index.js
# The bots' screens, Chromes and Hermes gateways are this server's children but outlive it: stopping
# or restarting the service (a deploy) stops only the server, which finds them again when it starts.
# systemd notes each one it finds still running as a "left-over process"; that is expected.
KillMode=process
Restart=always
RestartSec=2
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
