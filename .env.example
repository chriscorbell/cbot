# Copy to .env (development) or .env.prod (production) and fill in. Never commit either. compose.yaml
# reads .env into the dev container; scripts/deploy.sh copies .env.prod to /etc/cbot/env on the host.

# ---- the app ----
MAX_BOTS=4                        # cap on bots; each runs a screen, a Chrome and a Hermes gateway
# TZ=Europe/London                # the bots' time zone, an IANA name (default: UTC); the host clock can stay on UTC
# CBOT_HOST=my-server             # .env.prod only, required: the SSH host scripts/deploy.sh deploys to
# CBOT_PORT=8788                  # dev only: host port Compose publishes on 127.0.0.1
# PORT=8787                       # server port; the service unit and the dev container expect 8787
# HOST=127.0.0.1                  # address to listen on (default: all); the service unit sets 127.0.0.1
# HTTPS=1                         # HTTPS with cbot's own certificate on PORT, plain HTTP only from this machine; the installer sets it
# DATA_DIR=/var/lib/cbot          # database, generated secret and the bots' Hermes homes; the service unit sets /var/lib/cbot, Compose /data
# CBOT_NO_SCHEDULER=1             # dev only: no routines or check-ins (for a copy of production data)
# CBOT_API=http://127.0.0.1:8788  # dev only: where the Vite dev server sends API calls
# SPEECH_URL=http://speech:8000   # the speech service for voice; the service unit and compose.yaml set it

# Model keys, subscription tokens, the self-hosted model and the SearXNG address are set in the app,
# under Settings > Providers. An older .env's DEEPSEEK_API_KEY, CLAUDE_CODE_OAUTH_TOKEN,
# COPILOT_GITHUB_TOKEN and SEARXNG_URL are copied in on the first start and not read after that.
