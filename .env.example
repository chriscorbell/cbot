# Copy to .env (development) or .env.prod (production) and fill in. Never commit either. compose.yaml
# reads .env into the dev container; scripts/deploy.sh copies .env.prod to /etc/dispatch/env on the host.

# ---- the app ----
MAX_BOTS=4                            # cap on bots; each runs a screen, a Chrome and a Hermes gateway
# TZ=Europe/London                    # the bots' time zone, an IANA name (default: UTC); the host clock can stay on UTC
# DISPATCH_HOST=my-server             # .env.prod only, required: the SSH host scripts/deploy.sh deploys to
# DISPATCH_USER=me                    # .env.prod only, required: the ordinary account the bots run as (it gets passwordless sudo); the installer and the dev image set it
# DISPATCH_PORT=8788                  # dev only: host port Compose publishes on 127.0.0.1
# PORT=8787                           # server port; the service unit and the dev container expect 8787
# HOST=127.0.0.1                      # address to listen on (default: all); the service unit sets 127.0.0.1
# HTTPS=1                             # HTTPS with Dispatch's own certificate on PORT, plain HTTP only from this machine; the installer sets it
# DATA_DIR=/var/lib/dispatch          # database, generated secret and setup code, root's alone; the service unit sets /var/lib/dispatch, Compose /data
# DISPATCH_NO_SCHEDULER=1             # dev only: no routines or check-ins (for a copy of production data)
# DISPATCH_API=http://127.0.0.1:8788  # dev only: where the Vite dev server sends API calls
# SPEECH_URL=http://speech:8000       # the speech service for voice; compose.yaml sets it, and on a host deploy/speech.env's SPEECH_IP does

# Model keys, subscription tokens, the self-hosted model and the SearXNG address are set in the app,
# under Settings > Providers. An older .env's DEEPSEEK_API_KEY, CLAUDE_CODE_OAUTH_TOKEN,
# COPILOT_GITHUB_TOKEN and SEARXNG_URL are copied in on the first start and not read after that.
