    "reset-account": "node --env-file-if-exists=../.env dist/reset-account.js"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@hono/node-server": "2.1.9",
    "better-sqlite3": "13.2.0",
    "croner": "11.0.1",
    "hono": "4.13.19",
    "ws": "8.23.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
